{
  "name": "labelartor",
  "version": "1.2.0",
  "private": true,
  "description": "Web app to design and print labels on the Brother PT-P300BT over Web Serial (Bluetooth SPP).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run type-check && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "bun scripts/vue-tsc-bun.cjs --build",
    "test": "bun test",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . && prettier --check src/",
    "format": "prettier --write src/"
  },
  "prettier": {
    "$schema": "https://json.schemastore.org/prettierrc",
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "dependencies": {
    "@fontsource-variable/cuprum": "^5.3.0",
    "@fontsource-variable/finlandica": "^5.3.0",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/handjet": "^5.3.0",
    "@fontsource-variable/lilex": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource-variable/science-gothic": "^5.3.0",
    "@fontsource-variable/tektur": "^5.3.0",
    "@fontsource-variable/ysabeau-infant": "^5.3.0",
    "@fontsource/adwaita-mono": "^5.3.0",
    "@fontsource/arsenal-sc": "^5.3.0",
    "@fontsource/didact-gothic": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.0",
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@fontsource/gothic-a1": "^5.3.0",
    "@fontsource/ia-writer-mono": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
    "@fontsource/noto-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-sans-narrow": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "@fontsource/unifont": "^5.3.0",
    "halfmoon": "^2.0.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
}
